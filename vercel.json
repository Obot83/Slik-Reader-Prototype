{
  "builds": [
    { "src": "public/index.php", "use": "vercel-php@0.9.0" },
    { "src": "public/*.css", "use": "@vercel/static" },
    { "src": "public/*.js", "use": "@vercel/static" },
    { "src": "public/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/app.css", "dest": "/public/app.css" },
    { "src": "/index.html", "dest": "/public/index.html" },
    { "src": "/mobile_surveyor.html", "dest": "/public/mobile_surveyor.html" },
    { "src": "/slik-reader.html", "dest": "/public/slik-reader.html" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}
